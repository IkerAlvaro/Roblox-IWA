{
  "id": "/",
  "name": "Roblox IWA",
  "short_name": "Roblox",
  "description": "Cliente Isolated Web App de Roblox para ChromeOS.",
  "version": "1.0.1",
  "isolated_storage": true,
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["unframed", "standalone"],
  "orientation": "any",
  "background_color": "#0b0c10",
  "theme_color": "#e2231a",
  "lang": "es",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "fullscreen": ["self"],
    "pointer-lock": ["self"],
    "gamepad": ["self"]
  }
}
